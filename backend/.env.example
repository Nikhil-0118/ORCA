# Environment & Server
PROJECT_NAME="ORCA Marine Intelligence"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
LOG_LEVEL="info"

# Security & CORS
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# External ISRO / INCOIS / NavIC Data Connectors
MOSDAC_API_BASE_URL="https://mosdac.gov.in/api"
MOSDAC_API_KEY="your-mosdac-api-key"

INCOIS_ERDDAP_BASE_URL="https://erddap.incois.gov.in/erddap"
INCOIS_API_KEY="your-incois-api-key"

NAVIC_GATEWAY_URL="https://navic-hub.isro.gov.in/api"
NAVIC_API_KEY="your-navic-api-key"

# Emergency & Alerting Gateways
COAST_GUARD_MRCC_WEBHOOK_URL="https://mrcc-alerts.indiancoastguard.gov.in/webhook"
SMS_GATEWAY_API_URL="https://sms-gateway.gov.in/api/send"
SMS_GATEWAY_API_KEY="your-sms-api-key"

# Background Polling Interval (in seconds)
ALERT_POLL_INTERVAL_SECONDS=300
