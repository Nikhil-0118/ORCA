# ─── Environment & Server ──────────────────────────────────────────────────
PROJECT_NAME="ORCA Marine Intelligence"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
LOG_LEVEL="info"

# ─── Security & CORS ──────────────────────────────────────────────────────
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── LLM / AI Provider ────────────────────────────────────────────────────
# Your API key for the chosen LLM provider (OpenAI, Google Gemini, Anthropic, etc.)
LLM_API_KEY=""
# Provider name: "openai" | "google" | "anthropic"
LLM_PROVIDER=""

# ─── ISRO Bhuvan Geoportal ────────────────────────────────────────────────
# Register at https://bhuvan.nrsc.gov.in and generate an access token
BHUVAN_ACCESS_TOKEN=""

# ─── India Meteorological Department (optional) ───────────────────────────
# Sign up at https://mausam.imd.gov.in for API access (leave blank if unused)
IMD_API_KEY=""

# ─── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string, e.g. "postgresql+asyncpg://user:pass@localhost:5432/orca"
DATABASE_URL=""

# ─── Vector Store ─────────────────────────────────────────────────────────
# Path or URI for the vector database (e.g. ChromaDB directory "./data/vector_db")
VECTOR_DB_PATH=""

# ─── External ISRO / INCOIS / NavIC Data Connectors ───────────────────────
MOSDAC_API_BASE_URL="https://mosdac.gov.in/api"
# Register at https://mosdac.gov.in for satellite data access
MOSDAC_API_KEY=""

INCOIS_ERDDAP_BASE_URL="https://erddap.incois.gov.in/erddap"
# Register at https://incois.gov.in for ocean data services
INCOIS_API_KEY=""

NAVIC_GATEWAY_URL="https://navic-hub.isro.gov.in/api"
# NavIC positioning gateway API key from ISRO
NAVIC_API_KEY=""

# ─── Emergency & Alerting Gateways ────────────────────────────────────────
COAST_GUARD_MRCC_WEBHOOK_URL="https://mrcc-alerts.indiancoastguard.gov.in/webhook"
SMS_GATEWAY_API_URL="https://sms-gateway.gov.in/api/send"
SMS_GATEWAY_API_KEY=""

# ─── Background Polling Interval (in seconds) ─────────────────────────────
ALERT_POLL_INTERVAL_SECONDS=300
